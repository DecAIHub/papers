{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decaihub.io/schema/project-card/v1.1.0",
  "title": "AI-Blockchain Project Card (ABPC) v1.1.0",
  "description": "Data contract for ABPC records (snapshot February 2026). Controlled fields carry a canonical value and the curator's original descriptor (*_raw).",
  "type": "object",
  "required": ["project_id", "schema_version", "passport", "links", "evidence"],
  "additionalProperties": false,
  "properties": {
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "description": "<candidate number>-<slug>; numbers 1-909, gaps = excluded candidates" },
    "schema_version": { "type": "string", "const": "1.1.0" },
    "name": { "type": "string" },
    "ticker": { "type": ["string", "null"] },
    "token_contract": { "type": ["string", "null"], "description": "Primary token contract or mint address, verbatim" },
    "stub": { "type": "boolean", "description": "True for the 27 records without Category and with near-empty passport" },
    "card_verified_date": { "type": ["string", "null"], "format": "date", "description": "Last card-level verification (snapshot date of the record)" },
    "passport": {
      "type": "object",
      "required": ["Category", "chain", "type"],
      "additionalProperties": false,
      "properties": {
        "Category": { "type": ["string", "null"], "pattern": "^[A-Za-z/]+( \\| [A-Za-z/]+)*$", "description": "Canonical labels joined by ' | '; null for stub records" },
        "Category_raw": { "type": ["string", "null"] },
        "chain": { "type": ["string", "null"], "enum": ["Ethereum", "Solana", "Base", "BNB Chain", "Arbitrum", "Polygon", "Avalanche", "Sui", "Aptos", "Near", "Cosmos", "TON", "Fantom", "Optimism", "zkSync", "Bittensor", "other", null] },
        "chain_raw": { "type": ["string", "null"] },
        "type": { "type": ["string", "null"], "enum": ["EVM", "non-EVM", "Appchain", "L1", "L2", "Rollup", "Sidechain", null] },
        "type_raw": { "type": ["string", "null"] },
        "token_type": { "type": ["string", "null"], "enum": ["utility", "meme", "community", "none", "unknown", null], "description": "unknown = token exists, model not established; null = not populated" },
        "token_type_raw": { "type": ["string", "null"] },
        "token_mechanisms": { "type": ["array", "null"], "uniqueItems": true, "items": { "type": "string", "enum": ["payments", "fees", "gas", "staking", "governance", "rewards", "incentives", "access", "discounts", "burn", "buyback", "slashing", "security", "other"] } },
        "ai_component": { "type": ["string", "null"], "description": "Curator's free-text description of the primary AI functionality" },
        "ai_component_status": { "type": ["string", "null"], "enum": ["identified", "positioning_only", "none", "unknown", null], "description": "Derived from ai_component: identified = a component is described; positioning_only = AI claimed, no identifiable component in Tier-1 sources; none = Tier-1 sources indicate no AI component; unknown = could not be established" },
        "use_case": { "type": ["string", "null"], "description": "Curator's free-text description of the primary application domain" },
        "launch_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$" },
        "launch_date_raw": { "type": ["string", "null"] }
      }
    },
    "links": {
      "type": "object",
      "required": ["website"],
      "additionalProperties": false,
      "properties": {
        "website": { "type": ["string", "null"], "format": "uri" },
        "documentation": { "type": ["string", "null"], "format": "uri" },
        "whitepaper": { "type": ["string", "null"], "format": "uri" },
        "repository": { "type": ["string", "null"], "format": "uri" },
        "releases": { "type": ["string", "null"], "format": "uri" },
        "roadmap": { "type": ["string", "null"], "format": "uri" },
        "security_advisories": { "type": ["string", "null"], "format": "uri" },
        "app": { "type": ["string", "null"], "format": "uri" },
        "bug_bounty": { "type": ["string", "null"], "format": "uri" },
        "coingecko": { "type": ["string", "null"], "format": "uri" },
        "coinmarketcap": { "type": ["string", "null"], "format": "uri" },
        "explorer": { "type": ["array", "null"], "items": { "type": "string", "format": "uri" } },
        "audit": { "type": ["array", "null"], "items": { "type": "string", "format": "uri" } },
        "social": { "type": ["array", "null"], "items": { "type": "string", "format": "uri" }, "description": "Official channels (X, Telegram, Discord, Medium)" },
        "other": { "type": ["array", "null"], "items": { "type": "object", "required": ["type", "url"], "additionalProperties": false, "properties": { "type": { "type": "string" }, "url": { "type": "string", "format": "uri" } } } }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Source artifacts cited by the curator; one row per (URL, associated passport field)",
      "items": {
        "type": "object",
        "required": ["claim_field", "source_url", "tier"],
        "additionalProperties": false,
        "properties": {
          "claim_field": { "type": "string", "enum": ["Category", "chain", "type", "token_type", "ai_component", "use_case"], "description": "Derived from the curator's source note by a keyword rule (see data dictionary)" },
          "source_url": { "type": "string", "format": "uri" },
          "tier": { "type": "string", "enum": ["Tier-1", "Tier-2", "Tier-3"], "description": "Provenance class: Tier-1 project's own / on-chain / audit; Tier-2 aggregator; Tier-3 third-party" },
          "verified_date": { "type": ["string", "null"], "format": "date", "description": "Corpus-wide URL check (2026-03-05)" },
          "archive_url": { "type": ["string", "null"], "format": "uri", "description": "Internet Archive capture closest to 2026-03-05" },
          "archive_timestamp": { "type": ["string", "null"] }
        }
      }
    },
    "evidence_gaps": {
      "type": "array",
      "description": "Claims for which the curator looked for a primary source and found none (kind = not_found) or left a source-level note (kind = note)",
      "items": {
        "type": "object",
        "required": ["tier", "kind"],
        "additionalProperties": false,
        "properties": {
          "tier": { "type": "string", "enum": ["Tier-1", "Tier-2", "Tier-3"] },
          "kind": { "type": "string", "enum": ["not_found", "note"] }
        }
      }
    }
  }
}
